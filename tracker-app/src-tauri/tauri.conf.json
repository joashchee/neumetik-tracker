{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Neumetik Tracker",
  "version": "0.1.0",
  "identifier": "com.ansiapps.neumetiktracker",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1480",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Neumetik Tracker",
        "create": false,
        "width": 1280,
        "height": 760,
        "minWidth": 720,
        "minHeight": 480,
        "backgroundColor": "#14161a"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "copyright": "ansiapps",
    "license": "MIT",
    "shortDescription": "Tracker modules played and edited",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
